# Convex (filled in by `pnpm exec convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Same deployment as NEXT_PUBLIC_CONVEX_URL, but ending in .convex.site.
# /api/auth/* is forwarded there to Better Auth.
NEXT_PUBLIC_CONVEX_SITE_URL=

# These live in the Convex deployment, not in this file. Set them with:
#   pnpm exec convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#   pnpm exec convex env set SITE_URL http://localhost:3000
# BETTER_AUTH_SECRET signs sessions; SITE_URL is the public URL of this app.
# IS_TEST=true enables the e2e reset mutation (convex/testing.ts). Never set it
# on a production deployment.
#
# Rate limiting: Better Auth limits sign-in per IP using `x-forwarded-for`.
# Production must sit behind a proxy that sets that header (Vercel does), or the
# per-IP limit is skipped. The per-email limit (convex/rateLimits.ts) always
# applies, since clients can spoof the header.
